FROM node:22-alpine AS build

WORKDIR /app
COPY package*.json ./
RUN npm ci

ARG VITE_OMS_API=/api
ARG VITE_POSITION_API=/api
ARG VITE_PNL_API=/api
ARG VITE_RISK_API=/api
ARG VITE_MARKET_DATA_API=/api
ARG VITE_ANALYTICS_API=/api
ARG VITE_FIX_API=/api
ARG VITE_REPLAY_API=/api

ENV VITE_OMS_API=${VITE_OMS_API}
ENV VITE_POSITION_API=${VITE_POSITION_API}
ENV VITE_PNL_API=${VITE_PNL_API}
ENV VITE_RISK_API=${VITE_RISK_API}
ENV VITE_MARKET_DATA_API=${VITE_MARKET_DATA_API}
ENV VITE_ANALYTICS_API=${VITE_ANALYTICS_API}
ENV VITE_FIX_API=${VITE_FIX_API}
ENV VITE_REPLAY_API=${VITE_REPLAY_API}

COPY . .
RUN npm run build

FROM nginx:1.27-alpine
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 80
HEALTHCHECK --interval=30s --timeout=5s --retries=5 CMD wget -qO- http://localhost/ >/dev/null || exit 1
